{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may call only our own commands. No file, network or shell access is granted to the interface: links open, files save and the data folder is read and written through our commands, which check what they are given.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-parse-pack",
    "allow-check-pack",
    "allow-pack-file-limit",
    "allow-compare-packs",
    "allow-parse-catalog",
    "allow-reconcile-flight",
    "allow-restore-flight",
    "allow-new-flight",
    "allow-apply",
    "allow-rail",
    "allow-open-steps",
    "allow-suggestion",
    "allow-calculated",
    "allow-timers",
    "allow-cdu-walkthrough",
    "allow-phase-model",
    "allow-seat-frame",
    "allow-parse-flight",
    "allow-parse-settings",
    "allow-default-settings",
    "allow-plan-url",
    "allow-parse-plan",
    "allow-plan-values",
    "allow-other-aircraft",
    "allow-parse-saved-plan",
    "allow-plan-format",
    "allow-new-log",
    "allow-log-packs",
    "allow-parse-log",
    "allow-log-entry",
    "allow-practice-result",
    "allow-edit-log",
    "allow-log-csv",
    "allow-backup-text",
    "allow-read-backup",
    "allow-decode-metar",
    "allow-decode-taf",
    "allow-files-read",
    "allow-files-write",
    "allow-files-remove",
    "allow-files-set-aside",
    "allow-files-list",
    "allow-newer-release",
    "allow-open-link",
    "allow-save-file"
  ]
}
