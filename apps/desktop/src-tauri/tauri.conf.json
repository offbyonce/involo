{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Involo",
  "identifier": "com.offbyonce.involo",
  "build": {
    "beforeDevCommand": "pnpm --filter @involo/desktop dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm --filter @involo/desktop build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Involo",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://www.simbrief.com https://offbyonce.github.io https://api.github.com",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "category": "Utility",
    "shortDescription": "A procedures trainer for flight sim pilots",
    "copyright": "2026 offbyonce",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
