source: crates/involo-pack/tests/extend.rs
expression: flat
---
{
  "manifest": {
    "$schema": "../../../../../../schemas/pack.schema.json",
    "id": "example-variant",
    "name": "Example trainer variant (format demo)",
    "version": "0.1.0",
    "schemaVersion": 6,
    "kind": "aircraft",
    "engine": ">=0.1.0, <1.0.0",
    "aircraft": {
      "family": "Example trainer",
      "name": "Example trainer",
      "icaoTypes": [
        "ZZZZ"
      ],
      "simulator": "None: an invented format demo",
      "developer": "Involo examples"
    },
    "extends": {
      "example-trainer": ">=0.1.0, <1.0.0"
    },
    "patches": "patches.yaml",
    "resolved": [
      {
        "id": "example-trainer",
        "version": "0.1.0"
      }
    ],
    "license": "CC-BY-NC-SA-4.0",
    "attribution": [
      "Invented example content to show the pack format. Not for real-world or simulator use.",
      "Invented variant of the example trainer, for tests."
    ],
    "basisTags": [
      "invented-example",
      "prior-release"
    ],
    "checklists": []
  },
  "lists": [
    {
      "id": "before-start",
      "title": "Before start",
      "kind": "checklist",
      "basis": [
        "invented-example"
      ],
      "steps": [
        {
          "id": "example-trainer.before-start.battery",
          "number": 1,
          "text": "Battery switch",
          "expect": "ON",
          "controls": [
            "battery"
          ],
          "targets": [
            {
              "at": "overhead/electrical/BATTERY/1",
              "set": "ON"
            }
          ],
          "quick": "always",
          "why": "Gives the aircraft its first electrical power.",
          "check": "Voltage above 24 on the gauge",
          "if_not": "No voltage",
          "if_not_detail": "Check the battery is connected",
          "confirmed_by": [
            {
              "kind": "vendor-docs",
              "date": "2026-11-08"
            }
          ]
        },
        {
          "id": "example-trainer.before-start.doors",
          "number": 3,
          "section": "Cabin",
          "text": "Doors",
          "expect": "CLOSED",
          "show_if": {
            "any_of": [
              {
                "option": "power",
                "one_of": [
                  "external",
                  "internal"
                ]
              },
              {
                "option": "start",
                "equals": "turnaround"
              }
            ]
          },
          "panel_lights": {
            "battery": [
              "BATT LOW"
            ]
          },
          "sim_simplified": true
        },
        {
          "id": "example-variant.before-start.signs",
          "number": 4,
          "section": "Cabin",
          "text": "Cabin signs",
          "expect": "ON"
        }
      ]
    },
    {
      "id": "start-flow",
      "title": "Start flow",
      "kind": "flow",
      "basis": [
        "prior-release"
      ],
      "steps": [
        {
          "id": "example-trainer.start.walkaround",
          "text": "Nose area",
          "expect": "CLEAR",
          "walkaround": {
            "x": 160,
            "y": 40
          },
          "look_for": "Nothing blocking the intake.",
          "location": "At the nose, left side."
        },
        {
          "id": "example-trainer.start.computer",
          "text": "Flight computer",
          "expect": "SET",
          "hint": [
            {
              "prefix": "SQUAWK ",
              "field": "squawk"
            }
          ],
          "opens": "example-setup",
          "how": "computer",
          "explain": "computer-test"
        },
        {
          "id": "example-trainer.start.speeds",
          "text": "Takeoff speeds",
          "expect": "V1 ___, VR ___, NOTE ___",
          "fill": [
            "v1",
            "vr",
            "manual"
          ]
        },
        {
          "id": "example-trainer.start.warm-up",
          "text": "Engine warm-up",
          "expect": "COMPLETE",
          "timer": {
            "seconds": 120,
            "label": "Warm-up",
            "note": "A typical time.",
            "auto_start": {
              "from": [
                "example-trainer.start.computer"
              ],
              "pick": "latest"
            }
          }
        },
        {
          "id": "example-trainer.start.altitude",
          "text": "Altitude knob",
          "expect": "PULL",
          "controls": [
            "altitude-knob"
          ],
          "targets": [
            {
              "at": "autoflight/autoflight/#alt",
              "set": "PULL"
            }
          ]
        },
        {
          "id": "example-trainer.start.seat-belts",
          "text": "Seat belts",
          "expect": "ON",
          "controls": [
            "seat-belts"
          ],
          "targets": [
            {
              "at": "autoflight/cabin/#seat-belts",
              "set": "ON"
            }
          ]
        },
        {
          "id": "example-trainer.start.radio",
          "text": "Radio frequency",
          "expect": "ENT",
          "controls": [
            "radio-keypad"
          ],
          "targets": [
            {
              "at": "autoflight/cabin/#radio",
              "set": "ENT"
            }
          ]
        },
        {
          "id": "example-trainer.start.radar",
          "text": "Weather radar",
          "expect": "OFF",
          "not_simulated": true
        }
      ]
    },
    {
      "id": "smoke",
      "title": "Smoke in the cabin",
      "kind": "non-normal",
      "basis": [
        "invented-example"
      ],
      "memory": true,
      "when": "Smoke is seen or smelled.",
      "why": "Smoke can quickly make the crew unable to work.",
      "steps": [
        {
          "id": "example-trainer.smoke.masks",
          "text": "Oxygen masks",
          "expect": "ON"
        },
        {
          "id": "example-trainer.smoke.checklist",
          "text": "Reference checklist",
          "expect": "OPEN",
          "non_recall": true
        }
      ]
    }
  ],
  "content": {
    "phases": {
      "options": [
        {
          "id": "power",
          "title": "Power source",
          "values": [
            "external",
            "internal"
          ],
          "default": "external"
        },
        {
          "id": "start",
          "title": "Start type",
          "values": [
            "normal",
            "turnaround"
          ],
          "default": "normal"
        }
      ],
      "stages": [
        {
          "id": "departure",
          "title": "Departure",
          "phases": [
            {
              "phase": "start",
              "show_if": {
                "option": "start",
                "equals": "normal"
              }
            },
            {
              "phase": "before-start"
            }
          ]
        }
      ],
      "phases": [
        {
          "id": "start",
          "title": "Start",
          "engine_start": true,
          "lists": [
            "start-flow"
          ]
        },
        {
          "id": "before-start",
          "title": "Before start",
          "lists": [
            "before-start"
          ]
        },
        {
          "id": "memory",
          "title": "Memory items",
          "reference": true,
          "group": "memory",
          "intro": [
            {
              "text": "Steps to know by heart."
            },
            {
              "heading": "When to use them",
              "text": "As soon as you recognize the event."
            }
          ],
          "lists": [
            "smoke"
          ]
        }
      ]
    },
    "controls": {
      "zones": [
        {
          "id": "overhead-electrical",
          "area": "Overhead",
          "title": "Electrical panel",
          "short_title": "ELEC"
