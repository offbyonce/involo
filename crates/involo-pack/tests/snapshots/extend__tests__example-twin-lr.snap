      "walkthroughs": [
        {
          "id": "example-setup",
          "title": "Example set-up",
          "pages": [
            {
              "page": "PERF",
              "key": "INIT",
              "title": "Enter the fuel",
              "action": [
                "Type ",
                {
                  "field": "fuel_thousands",
                  "empty": "the planned fuel"
                },
                " and press 1L."
              ],
              "check": [
                {
                  "when_known": [
                    "zfw"
                  ],
                  "show": [
                    "Your weight is shown."
                  ],
                  "otherwise": [
                    "Enter your weight."
                  ]
                }
              ],
              "note": [
                "Weights are in thousands of",
                {
                  "field": "weight_unit",
                  "before": " ",
                  "after": ".",
                  "empty": " pounds."
                },
                {
                  "route_legs": "overflow",
                  "per_page": 5,
                  "before": " ",
                  "after": " more route rows follow."
                }
              ],
              "screen": {
                "title": [
                  "PERF"
                ],
                "page": [
                  "1/",
                  {
                    "route_legs": "pages",
                    "per_page": 5
                  }
                ],
                "rows": [
                  {
                    "left_label": [
                      "FUEL"
                    ],
                    "left": [
                      {
                        "field": "fuel_thousands",
                        "style": "user",
                        "empty": "□□□.□",
                        "empty_style": "data"
                      }
                    ],
                    "right_label": [
                      "RUNWAY"
                    ],
                    "right": [
                      {
                        "when_known": [
                          "runway"
                        ],
                        "show": [
                          "<SEL> ",
                          {
                            "field": "runway",
                            "style": "user",
                            "before": "RW"
                          }
                        ],
                        "otherwise": [
                          {
                            "text": "(list of runways)",
                            "style": "data"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "left_label": [
                      "VIA"
                    ],
                    "left": [
                      {
                        "field": "route_leg",
                        "index": 1,
                        "part": "via",
                        "style": "user",
                        "empty": "------"
                      }
                    ],
                    "right_label": [
                      "TO"
                    ],
                    "right": [
                      {
                        "field": "route_leg",
                        "index": 1,
                        "part": "to",
                        "style": "user",
                        "empty": "------"
                      }
                    ]
                  },
                  {
                    "left_label": [
                      "GROSS WT"
                    ],
                    "left": [
                      {
                        "field": "gross_weight",
                        "style": "accent",
                        "empty": "□□□.□",
                        "empty_style": "data"
                      }
                    ],
                    "right_label": [
                      "CRZ WIND"
                    ],
                    "right": [
                      {
                        "field": "cruise_wind",
                        "form": "wind",
                        "style": "user",
                        "empty": "---°/---"
                      }
                    ]
                  },
                  {
                    "separator": "",
                    "left": [
                      "<INDEX"
                    ],
                    "right": [
                      {
                        "text": "DONE>",
                        "style": "accent"
                      }
                    ]
                  }
                ],
                "highlight": [
                  "1L"
                ],
                "scratchpad": [
                  {
                    "field": "fuel_thousands"
                  }
                ]
              }
            }
          ]
        }
      ]
