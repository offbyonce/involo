{
  "manifest": {
    "$schema": "../../../schemas/pack.schema.json",
    "id": "example-twin-lr",
    "name": "Example Twin LR",
    "version": "0.1.0",
    "schemaVersion": 6,
    "kind": "aircraft",
    "engine": ">=0.1.0, <1.0.0",
    "aircraft": {
      "family": "Example Twin",
      "name": "Example Twin",
      "icaoTypes": [
        "ZZZT"
      ],
      "simulator": "None: an invented example",
      "developer": "Involo examples"
    },
    "extends": {
      "example-twin": ">=0.1.0, <1.0.0"
    },
    "patches": "patches.yaml",
    "resolved": [
      {
        "id": "example-twin",
        "version": "0.1.0"
      }
    ],
    "license": "CC-BY-NC-SA-4.0",
    "attribution": [
      "Invented example content to show the pack format. Not for real-world or simulator use.",
      "Invented example content: a longer-range version of the Example Twin. Not for real-world or simulator use."
    ],
    "basisTags": [
      "invented-example",
      "prior-release"
    ],
    "checklists": []
  },
  "lists": [
    {
      "id": "before-start",
      "title": "Before start",
      "kind": "checklist",
      "basis": [
        "invented-example"
      ],
      "steps": [
        {
          "id": "example-twin.before-start.battery",
          "number": 1,
          "text": "Battery switch",
          "expect": "ON",
          "controls": [
            "battery"
          ],
          "targets": [
            {
              "at": "overhead/electrical/BATTERY/1",
              "set": "ON"
            },
            {
              "at": "overhead/electrical/BATT LOW/1",
              "light": "out"
            }
          ],
          "quick": "always",
          "why": "Gives the aircraft its first electrical power.",
          "check": "Voltage above 24 on the gauge",
          "check_detail": "About 24 volts, steady",
          "if_not": "No voltage",
          "if_not_detail": "Check the battery is connected",
          "confirmed_by": [
            {
              "kind": "vendor-docs",
              "date": "2026-11-08"
            }
          ]
        },
        {
          "id": "example-twin.before-start.doors",
          "number": 3,
          "section": "Cabin",
          "text": "Doors",
          "expect": "CLOSED",
          "show_if": {
            "any_of": [
              {
                "option": "power",
                "one_of": [
                  "external",
                  "internal"
                ]
              },
              {
                "option": "start",
                "equals": "turnaround"
              }
            ]
          },
          "panel_lights": {
            "battery": [
              "BATT LOW"
            ]
          },
          "sim_simplified": true
        },
        {
          "id": "example-twin-lr.before-start.signs",
          "number": 4,
          "section": "Cabin",
          "text": "Cabin signs",
          "expect": "ON"
        },
        {
          "id": "example-twin-lr.before-start.center-tank",
          "section": "Fuel",
          "text": "Center tank quantity",
          "expect": "CHECK"
        },
        {
          "id": "example-twin.before-start.fuel-balance",
          "number": 4,
          "section": "Fuel",
          "text": "Fuel balance",
          "expect": "CHECK THE TWO TANK QUANTITIES",
          "decide": "crossfeed",
          "terms": [
            "CDU"
          ]
        },
        {
          "id": "example-twin.before-start.crossfeed",
          "number": 5,
          "section": "Fuel",
          "text": "Crossfeed switch",
          "expect": "ON IF THE TANKS ARE UNEVEN, ELSE OFF",
          "controls": [
            "crossfeed"
          ],
          "targets": [
            {
              "at": "overhead/fuel/CROSSFEED/1",
              "open": true
            },
            {
              "at": "overhead/fuel/CROSSFEED/1",
              "set": "ON",
              "when": {
                "option": "crossfeed",
                "equals": "uneven"
              }
            },
            {
              "at": "overhead/fuel/CROSSFEED/1",
              "set": "OFF",
              "when": {
                "option": "crossfeed",
                "equals": "balanced"
              }
            }
          ],
          "expect_when": [
            {
              "option": "crossfeed",
              "equals": "uneven",
              "expect": "ON"
            },
            {
              "option": "crossfeed",
              "equals": "balanced",
              "expect": "OFF"
            }
          ]
        }
      ]
    },
    {
      "id": "start-flow",
      "title": "Start flow",
      "kind": "flow",
      "basis": [
        "prior-release"
      ],
      "steps": [
        {
          "id": "example-twin.start.walkaround",
          "text": "Nose area",
          "expect": "CLEAR",
          "walkaround": {
            "x": 160,
            "y": 40
          },
          "look_for": "Nothing blocking the intake.",
          "location": "At the nose, left side."
        },
        {
          "id": "example-twin.start.computer",
          "text": "Flight computer",
          "expect": "SET",
          "hint": [
            {
              "prefix": "SQUAWK ",
              "field": "squawk"
            }
          ],
          "opens": "example-setup",
          "how": "computer",
          "explain": "computer-test"
        },
        {
          "id": "example-twin.start.speeds",
          "text": "Takeoff speeds",
          "expect": "V1 ___, VR ___, NOTE ___",
          "fill": [
            "v1",
            "vr",
            "manual"
          ]
        },
        {
          "id": "example-twin.start.warm-up",
          "text": "Engine warm-up",
          "expect": "COMPLETE",
          "timer": {
            "seconds": 120,
            "label": "Warm-up",
            "note": "A typical time.",
            "auto_start": {
              "from": [
                "example-twin.start.computer"
              ],
              "pick": "latest"
            }
          }
        },
        {
          "id": "example-twin.start.display",
          "text": "Display selector",
          "expect": "ENGINE",
          "controls": [
            "display-selector"
          ],
          "targets": [
            {
              "at": "pedestal/displays/#display",
              "set": "ENGINE"
            }
          ]
        },
        {
          "id": "example-twin.start.seat-belts",
          "text": "Seat belts",
          "expect": "ON",
          "controls": [
            "seat-belts"
          ],
          "targets": [
            {
              "at": "pedestal/cabin/#seat-belts",
              "set": "ON"
            }
          ]
        },
        {
          "id": "example-twin.start.radio",
          "text": "Radio frequency",
          "expect": "ENT",
          "controls": [
            "radio-keypad"
          ],
          "targets": [
            {
              "at": "pedestal/cabin/#radio",
              "set": "ENT"
            }
          ]
        },
        {
          "id": "example-twin.start.parking-brake",
          "text": "Parking brake",
          "expect": "SET",
          "controls": [
            "parking-brake"
          ],
          "targets": [
            {
              "at": "pedestal/brakes/#brake",
              "set": "SET"
            }
          ]
        },
        {
          "id": "example-twin.start.radar",
          "text": "Weather radar",
          "expect": "OFF",
          "show_if": {
            "all_of": [
              {
                "option": "power",
                "equals": "external"
              },
              {
                "option": "start",
                "one_of": [
                  "normal",
                  "turnaround"
                ]
              }
            ]
          },
          "not_simulated": true
        }
      ]
    },
    {
      "id": "smoke",
      "title": "Smoke or fumes in the cabin",
      "kind": "non-normal",
      "basis": [
        "invented-example"
      ],
      "memory": true,
      "when": "Smoke is seen or smelled.",
      "why": "Smoke can quickly make the crew unable to work.",
      "steps": [
        {
          "id": "example-twin.smoke.masks",
          "text": "Oxygen masks",
          "expect": "ON"
        },
        {
          "id": "example-twin.smoke.checklist",
          "text": "Reference checklist",
          "expect": "OPEN",
          "non_recall": true
        }
      ]
    },
    {
      "id": "battery-low",
      "title": "Battery low",
      "kind": "non-normal",
      "basis": [
        "invented-example"
      ],
      "when": "The BATT LOW light is on.",
      "why": "A flat battery leaves nothing to start the engines with.",
      "steps": [
        {
          "id": "example-twin.battery-low.external",
          "number": 1,
          "text": "External power",
          "expect": "CONNECT"
        },
        {
          "id": "example-twin-lr.battery-low.if-unavailable",
          "number": 2,
          "text": "IF EXTERNAL POWER IS NOT AVAILABLE",
          "expect": "START THE AUXILIARY POWER UNIT",
          "branch": true
        },
        {
          "id": "example-twin.battery-low.battery",
          "number": 3,
          "text": "Battery switch",
          "expect": "OFF",
          "controls": [
            "battery"
          ],
          "targets": [
            {
              "at": "overhead/electrical/BATTERY/1",
              "set": "OFF"
            }
          ]
        }
      ]
    }
  ],
  "content": {
    "phases": {
      "options": [
        {
          "id": "power",
          "title": "Power source",
          "values": [
            "external",
            "internal"
          ],
          "default": "external"
