---
source: crates/involo-pack-cli/tests/snapshot.rs
---
{
  "fields": [
    {
      "id": "origin",
      "label": "Departure",
      "description": "The airport you depart from. Its weather is on the Weather page.",
      "kind": "text",
      "location": "Enter on the CDU › RTE",
      "page": "route",
      "group": "Airports",
      "show_in": [
        "strip"
      ],
      "simbrief": [
        "origin"
      ]
    },
    {
      "id": "destination",
      "label": "Destination",
      "description": "Where you plan to land.",
      "kind": "text",
      "location": "Enter on the CDU › RTE",
      "page": "route",
      "group": "Airports",
      "show_in": [
        "strip"
      ],
      "strip": {
        "join": " → "
      },
      "simbrief": [
        "destination"
      ]
    },
    {
      "id": "alternate",
      "label": "Alternate",
      "description": "Where you'd divert if you couldn't land at the destination.",
      "kind": "text",
      "location": "Enter on the CDU › RTE 2",
      "page": "route",
      "group": "Airports",
      "simbrief": [
        "alternate"
      ]
    },
    {
      "id": "flight_number",
      "label": "Flight number",
      "description": "Your flight's number, as filed.",
      "kind": "text",
      "location": "Enter on the CDU › RTE",
      "page": "route",
      "group": "Airports",
      "simbrief": [
        "flight_number"
      ]
    },
    {
      "id": "route",
      "label": "Route",
      "description": "The filed route from the SID to the arrival, as you enter it in the CDU.",
      "kind": "text",
      "location": "Enter on the CDU › RTE",
      "page": "route",
      "group": "The route",
      "simbrief": [
        "route"
      ]
    },
    {
      "id": "runway",
      "label": "Runway",
      "description": "The runway you depart from.",
      "kind": "text",
      "location": "Enter on the CDU › DEP/ARR",
      "page": "clearance",
      "group": "Departure clearance",
      "show_in": [
        "strip"
      ],
      "strip": {
        "prefix": "RWY "
      },
      "simbrief": [
        "runway"
      ]
    },
    {
      "id": "sid",
      "label": "SID",
      "description": "The departure procedure.",
      "kind": "text",
      "location": "Enter on the CDU › DEP/ARR",
      "page": "clearance",
      "group": "Departure clearance",
      "show_in": [
        "strip"
      ],
      "simbrief": [
        "sid"
      ]
    },
    {
      "id": "transition",
      "label": "Transition",
      "description": "Where the SID joins your route.",
      "kind": "text",
      "location": "Enter on the CDU › DEP/ARR",
      "page": "clearance",
      "group": "Departure clearance",
      "show_in": [
        "strip"
      ],
      "strip": {
        "join": "."
      },
      "simbrief": [
        "transition"
      ]
    },
    {
      "id": "initial_altitude",
      "label": "Initial altitude",
      "description": "The altitude you're cleared to climb to first.",
      "kind": "number",
      "ranges": [
        {
          "min": 0.0,
          "max": 41000.0
        }
      ],
      "location": "Set on the MCP › ALTITUDE",
      "page": "clearance",
      "group": "Departure clearance",
      "show_in": [
        "strip"
      ],
      "strip": {
        "suffix": " FT"
      }
    },
    {
      "id": "squawk",
      "label": "Squawk",
      "description": "Your transponder code.",
      "kind": "text",
      "location": "Set on the transponder",
      "page": "clearance",
      "group": "Departure clearance",
      "show_in": [
        "strip"
      ],
      "strip": {
        "prefix": "SQK "
      }
    },
    {
      "id": "ground_frequency",
      "label": "Ground",
      "description": "For pushback and taxi.",
      "kind": "text",
      "location": "Set on the radio panel",
      "page": "clearance",
      "group": "Frequencies",
      "show_in": [
        "strip"
      ],
      "strip": {
        "prefix": "GND "
      }
    },
    {
      "id": "tower_frequency",
      "label": "Tower",
      "description": "For takeoff.",
      "kind": "text",
      "location": "Set on the radio panel",
      "page": "clearance",
      "group": "Frequencies"
    },
    {
      "id": "departure_frequency",
      "label": "Departure frequency",
      "description": "The frequency to call after takeoff.",
      "kind": "text",
      "location": "Set on the radio panel",
      "page": "clearance",
      "group": "Frequencies",
      "show_in": [
        "strip"
      ],
      "strip": {
        "prefix": "DEP "
      }
    },
    {
      "id": "qnh",
      "label": "Altimeter setting (departure)",
      "kind": "number",
      "unit": "qnh_unit",
      "ranges": [
        {
          "unit": "inHg",
          "min": 28.0,
          "max": 31.0
        },
        {
          "unit": "hPa",
          "min": 948.0,
          "max": 1050.0
        }
      ],
      "simbrief": [
        "origin_altimeter"
      ]
    },
    {
      "id": "destination_qnh",
      "label": "Altimeter setting (destination)",
      "kind": "number",
      "unit": "qnh_unit",
      "ranges": [
        {
          "unit": "inHg",
          "min": 28.0,
          "max": 31.0
        },
        {
          "unit": "hPa",
          "min": 948.0,
          "max": 1050.0
        }
      ],
      "simbrief": [
        "destination_altimeter"
      ]
    },
    {
      "id": "heading",
      "label": "Runway heading",
      "description": "The heading of your takeoff runway.",
      "kind": "number",
      "ranges": [
        {
          "min": 1.0,
          "max": 360.0
        }
      ],
      "location": "Set on the MCP › HEADING",
      "page": "takeoff",
      "group": "Runway"
    },
    {
      "id": "takeoff_flaps",
      "label": "Flaps",
      "description": "Takeoff flaps for your weight and runway.",
      "kind": "choice",
      "choices": [
        {
          "value": "1"
        },
        {
          "value": "5"
        },
        {
          "value": "10"
        },
        {
          "value": "15"
        },
        {
          "value": "25"
        }
      ],
      "location": "Enter on the CDU › TAKEOFF REF",
      "page": "takeoff",
      "group": "Settings and speeds"
    },
    {
      "id": "landing_flaps",
      "label": "Landing flaps",
      "description": "The flaps you land with. Landing speed is VREF for this setting.",
      "kind": "choice",
      "choices": [
        {
          "value": "15"
        },
        {
          "value": "30"
        },
        {
          "value": "40"
        }
      ],
      "location": "Enter on the CDU › APPROACH REF",
      "page": "approach",
      "group": "Landing",
      "show_in": [
        "arrival"
      ]
    },
    {
      "id": "v1",
      "label": "V1",
      "description": "Decision speed. Before it you can stop; after it you go.",
      "kind": "number",
      "ranges": [
        {
          "min": 80.0,
          "max": 250.0
        }
      ],
      "location": "Enter on the CDU › TAKEOFF REF",
      "page": "takeoff",
      "group": "Settings and speeds"
    },
    {
      "id": "vr",
      "label": "VR",
      "description": "Rotation speed.",
      "kind": "number",
      "ranges": [
        {
          "min": 80.0,
          "max": 250.0
        }
      ],
      "location": "Enter on the CDU › TAKEOFF REF",
      "page": "takeoff",
      "group": "Settings and speeds"
    },
    {
      "id": "v2",
      "label": "V2",
      "description": "Takeoff safety speed for your takeoff flaps.",
      "kind": "number",
      "ranges": [
        {
          "min": 100.0,
          "max": 250.0
        }
      ],
      "location": "Enter on the CDU › TAKEOFF REF",
      "page": "takeoff",
      "group": "Settings and speeds"
    },
    {
      "id": "vref",
      "label": "Landing speed",
      "description": "VREF for your landing flaps, plus any wind additive.",
      "kind": "number",
      "ranges": [
        {
          "min": 100.0,
          "max": 250.0
        }
      ],
      "location": "Enter on the CDU › APPROACH REF",
      "page": "approach",
      "group": "Landing",
      "show_in": [
        "arrival"
      ]
    },
    {
      "id": "cg",
      "label": "ZFW CG",
      "description": "Center of gravity without fuel, used for takeoff trim.",
      "kind": "number",
      "ranges": [
        {
          "min": 0.0,
          "max": 50.0
        }
      ],
      "location": "Enter on the CDU › TAKEOFF REF",
      "page": "fuel",
      "group": "Weights"
    },
    {
      "id": "takeoff_trim",
      "label": "Stabilizer trim",
      "description": "Takeoff trim for your weight and balance.",
      "kind": "number",
      "ranges": [
        {
          "min": 0.0,
          "max": 15.0
        }
      ],
      "location": "Enter on the CDU › TAKEOFF REF",
      "page": "takeoff",
      "group": "Settings and speeds"
    },
    {
      "id": "autobrake",
      "label": "Autobrake",
      "description": "How hard the brakes apply on touchdown.",
      "kind": "choice",
      "choices": [
        {
          "value": "OFF"
        },
        {
          "value": "1"
        },
        {
          "value": "2"
        },
        {
          "value": "3"
        },
        {
          "value": "MAX"
        }
      ],
      "location": "Set on the autobrake selector",
      "page": "approach",
      "group": "Landing",
      "show_in": [
        "arrival"
      ]
    },
    {
      "id": "minimums",
      "label": "Minimums",
      "description": "The height where you must see the runway to continue, from the approach chart. BARO for most approaches; RADIO when the chart gives a radio altimeter height.",
      "kind": "number",
      "ranges": [
        {
          "min": 0.0,
          "max": 14000.0
        }
      ],
      "location": "Set on the EFIS › MINS",
      "page": "approach",
      "group": "Landing",
      "show_in": [
        "arrival"
      ]
    },
    {
      "id": "landing_altitude",
      "label": "Landing altitude",
      "description": "The destination field elevation, from the plan.",
      "kind": "number",
      "ranges": [
        {
          "min": -1000.0,
          "max": 14000.0
        }
      ],
      "location": "Set on the pressurization panel › LAND ALT",
      "page": "approach",
      "group": "Landing",
      "show_in": [
        "arrival"
      ],
      "simbrief": [
        "destination_elevation"
      ]
    },
    {
      "id": "arrival_runway",
      "label": "Arrival runway",
