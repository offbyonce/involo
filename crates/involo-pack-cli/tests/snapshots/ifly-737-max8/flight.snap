      "ranges": [
        {
          "min": 0.0,
          "max": 9999.0,
          "message": "Enter 0 to 9999"
        }
      ],
      "location": "Enter on the CDU › PERF INIT",
      "page": "cruise",
      "group": "Cruise",
      "simbrief": [
        "cost_index"
