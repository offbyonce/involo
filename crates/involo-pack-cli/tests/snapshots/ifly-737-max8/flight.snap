      "ranges": [
        {
          "min": 80.0,
          "max": 250.0,
          "message": "Enter 80 to 250 knots"
        }
      ],
      "location": "Enter on the CDU › TAKEOFF REF",
      "page": "takeoff",
      "group": "Settings and speeds",
      "input": {
        "max_length": 3,
        "mode": "numeric"
      },
      "spoken": "V1"
    },
    {
      "id": "vr",
      "label": "VR",
      "description": "Rotation speed.",
      "kind": "number",
      "ranges": [
        {
          "min": 80.0,
          "max": 250.0,
          "message": "Enter 80 to 250 knots"
        }
      ],
      "location": "Enter on the CDU › TAKEOFF REF",
      "page": "takeoff",
      "group": "Settings and speeds",
      "input": {
        "max_length": 3,
        "mode": "numeric"
      },
      "spoken": "VR"
    },
    {
      "id": "v2",
      "label": "V2",
      "description": "Takeoff safety speed for your takeoff flaps.",
      "kind": "number",
      "ranges": [
        {
          "min": 100.0,
          "max": 250.0,
          "message": "Enter 100 to 250 knots"
        }
      ],
      "location": "Enter on the CDU › TAKEOFF REF",
      "page": "takeoff",
      "group": "Settings and speeds",
      "input": {
        "max_length": 3,
        "mode": "numeric",
        "placeholder": "From the FMC"
      },
      "spoken": "V2"
    },
    {
      "id": "vref",
      "label": "Landing speed",
      "description": "VREF for your landing flaps, plus any wind additive.",
      "kind": "number",
      "ranges": [
        {
          "min": 100.0,
          "max": 250.0,
          "message": "Enter 100 to 250 knots"
        }
      ],
      "location": "Enter on the CDU › APPROACH REF",
      "page": "approach",
      "group": "Landing",
      "show_in": [
        "arrival"
      ],
      "input": {
        "max_length": 3,
        "mode": "numeric",
        "placeholder": "From the FMC"
      },
      "spoken": "VREF",
      "ofp": {
        "title": "Landing speed comes from the FMC"
      }
    },
    {
      "id": "cg",
      "label": "ZFW CG",
      "description": "Center of gravity without fuel, used for takeoff trim.",
      "kind": "number",
      "ranges": [
        {
          "min": 0.0,
          "max": 50.0,
          "message": "Enter 0 to 50% MAC"
        }
      ],
      "location": "Enter on the CDU › TAKEOFF REF",
      "page": "fuel",
      "group": "Weights",
      "input": {
        "mode": "decimal"
      },
      "show": {
        "suffix": "%"
      },
      "ofp": {
        "from": "zero_fuel_weight",
        "title": "The CG is in the weights section",
        "note": "Some layouts print the CG beside the zero fuel weight."
      }
    },
    {
      "id": "takeoff_trim",
      "label": "Stabilizer trim",
      "description": "Takeoff trim for your weight and balance.",
      "kind": "number",
      "ranges": [
        {
          "min": 0.0,
          "max": 15.0,
          "message": "Enter 0.00 to 15.00 units"
        }
      ],
      "location": "Enter on the CDU › TAKEOFF REF",
      "page": "takeoff",
      "group": "Settings and speeds",
      "input": {
        "max_length": 5,
        "mode": "decimal",
        "placeholder": "From the FMC"
      }
    },
    {
      "id": "autobrake",
      "label": "Autobrake",
      "description": "How hard the brakes apply on touchdown.",
      "kind": "choice",
      "choices": [
        {
          "value": "OFF"
        },
        {
          "value": "1"
        },
        {
          "value": "2"
        },
        {
          "value": "3"
        },
        {
          "value": "MAX"
        }
      ],
      "location": "Set on the autobrake selector",
      "page": "approach",
      "group": "Landing",
      "show_in": [
        "arrival"
      ],
      "ofp": {
        "title": "Autobrake is your choice for the runway"
      }
    },
    {
      "id": "minimums",
      "label": "Minimums",
      "description": "The height where you must see the runway to continue, from the approach chart. BARO for most approaches; RADIO when the chart gives a radio altimeter height.",
      "kind": "number",
      "ranges": [
        {
          "min": 0.0,
          "max": 14000.0,
          "message": "Enter 0 to 14,000 ft"
        }
      ],
      "location": "Set on the EFIS › MINS",
      "page": "approach",
      "group": "Landing",
      "show_in": [
        "arrival"
      ],
      "input": {
        "max_length": 5,
        "mode": "numeric",
        "placeholder": "Enter"
      },
      "toggle": "minimums_type",
      "ofp": {
        "title": "Minimums come from the approach chart"
      }
    },
    {
      "id": "landing_altitude",
      "label": "Landing altitude",
      "description": "The destination field elevation, from the plan.",
      "kind": "number",
      "ranges": [
        {
          "min": -1000.0,
          "max": 14000.0,
          "message": "Enter −1,000 to 14,000 ft"
        }
      ],
      "location": "Set on the pressurization panel › LAND ALT",
      "page": "approach",
      "group": "Landing",
      "show_in": [
        "arrival"
      ],
      "simbrief": [
        "destination_elevation"
      ],
      "input": {
        "max_length": 5,
        "mode": "numeric"
      },
      "ofp": {
        "body": "The header's route line ends with the arrival: the STAR, then the destination and its runway. The destination's elevation is in the header too. Minimums and landing speed come from the approach chart and the FMC, not the OFP."
      }
    },
    {
      "id": "arrival_runway",
      "label": "Arrival runway",
      "description": "The runway you expect to land on. Check it against the ATIS before you brief.",
      "kind": "text",
      "location": "Enter on the CDU › DEP/ARR",
      "page": "approach",
      "group": "Arrival",
      "simbrief": [
        "arrival_runway"
      ],
      "input": {
        "max_length": 4
      },
      "ofp": {
        "body": "The header's route line ends with the arrival: the STAR, then the destination and its runway. The destination's elevation is in the header too. Minimums and landing speed come from the approach chart and the FMC, not the OFP."
      }
    },
    {
      "id": "star",
      "label": "Arrival (STAR)",
      "description": "The published route from the airway to the approach.",
      "kind": "text",
      "location": "Enter on the CDU › DEP/ARR",
      "page": "approach",
      "group": "Arrival",
      "simbrief": [
        "star"
      ],
      "input": {
        "max_length": 8,
        "placeholder": "Enter"
      },
      "needed": true,
      "ofp": {
        "body": "The header's route line ends with the arrival: the STAR, then the destination and its runway. The destination's elevation is in the header too. Minimums and landing speed come from the approach chart and the FMC, not the OFP."
      }
    },
    {
      "id": "minimum_takeoff_fuel",
      "label": "Minimum takeoff fuel",
      "description": "The least fuel to start the takeoff with: trip, contingency, alternate and final reserve. Check you have at least this before takeoff.",
      "kind": "number",
      "unit": "weight_unit",
      "page": "fuel",
      "group": "Fuel",
      "simbrief": [
        "minimum_takeoff_fuel"
      ],
      "read_only": true,
      "phase": "before-start"
    },
    {
      "id": "fuel",
      "label": "Block fuel",
      "description": "All the fuel on board before engine start.",
      "kind": "number",
      "unit": "weight_unit",
      "location": "Check on the fuel gauges",
      "page": "fuel",
      "group": "Fuel",
      "simbrief": [
        "block_fuel"
      ],
      "input": {
        "mode": "numeric"
      }
    },
    {
      "id": "zfw",
      "label": "Zero fuel weight",
      "description": "The airplane's weight without fuel.",
      "kind": "number",
      "unit": "weight_unit",
      "ranges": [
        {
          "min": 0.0,
          "max": 400.0,
          "message": "Enter 0 to 400,000 {unit}"
        }
      ],
      "location": "Enter on the CDU › PERF INIT",
      "page": "fuel",
      "group": "Weights",
      "display": {
        "scale": 1000.0,
        "round": "up",
        "step": 0.1
      },
      "simbrief": [
        "zero_fuel_weight"
      ],
      "input": {
        "mode": "decimal"
      },
      "ofp": {
        "note": "Enter it in thousands, as the CDU takes it."
      }
    },
    {
      "id": "takeoff_weight",
      "label": "Planned takeoff weight",
      "description": "Zero fuel weight plus fuel at takeoff, from the plan.",
      "kind": "number",
      "unit": "weight_unit",
      "ranges": [
        {
          "min": 0.0,
          "max": 400.0,
          "message": "Enter 0 to 400,000 {unit}"
        }
      ],
      "location": "Enter on the CDU › PERF INIT",
      "page": "fuel",
      "group": "Weights",
      "display": {
        "scale": 1000.0,
        "round": "nearest",
        "step": 0.1
      },
      "simbrief": [
        "takeoff_weight"
      ],
      "input": {
        "mode": "decimal"
      },
      "ofp": {
        "note": "Cross-check it with the FMC's gross weight."
      }
    },
    {
      "id": "passengers",
      "label": "Passengers and cargo",
