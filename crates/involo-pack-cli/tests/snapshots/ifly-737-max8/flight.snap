    {
      "id": "thrust_rating",
      "label": "Takeoff thrust",
      "description": "The rating from your takeoff performance in the EFB. TO is full thrust; TO-1 and TO-2 are fixed derates that give less.",
      "kind": "choice",
      "choices": [
        {
          "value": "TO"
        },
        {
          "value": "TO-1"
        },
        {
          "value": "TO-2"
        }
      ],
      "location": "Enter on the CDU › N1 LIMIT",
      "page": "takeoff",
      "group": "Settings and speeds"
    },
    {
      "id": "assumed_temperature",
      "label": "Assumed temperature (SEL)",
      "description": "From your takeoff performance in the EFB. A temperature hotter than the real one, so the FMC sets less thrust and saves the engines.",
      "kind": "number",
      "location": "Enter on the CDU › N1 LIMIT",
      "page": "takeoff",
      "group": "Settings and speeds"
    },
    {
      "id": "thrust_reduction_altitude",
