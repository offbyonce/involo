---
source: crates/involo-pack-cli/tests/snapshot.rs
---
{
  "pages": [
    {
      "id": "route",
      "title": "Route",
      "sub": "Where you're going and the way there. Used by the route and CDU steps.",
      "selected": "route",
      "groups": [
        {
          "title": "Airports",
          "fields": [
            "origin",
            "destination",
            "alternate",
            "flight_number"
          ]
        },
        {
          "title": "The route",
          "fields": [
            "route",
            "planned_distance",
            "planned_time"
          ]
        }
      ]
    },
    {
      "id": "fuel",
      "title": "Fuel and weights",
      "sub": "Numbers for the fuel and weight steps and the CDU's PERF INIT page.",
      "selected": "fuel",
      "groups": [
        {
          "title": "Fuel",
          "units": {
            "field": "weight_unit",
            "label": "Weights in"
          },
          "fields": [
            "fuel",
            "center_tank_fuel",
            "trip_fuel",
            "reserves",
            "taxi_fuel",
            "minimum_takeoff_fuel"
          ]
        },
        {
          "title": "Weights",
          "note": "Same unit as fuel",
          "fields": [
            "zfw",
            "cg",
            "passengers",
            "takeoff_weight"
          ]
        }
      ]
    },
    {
      "id": "cruise",
      "title": "Cruise and levels",
      "sub": "Used by the climb, cruise and descent steps.",
      "selected": "cost_index",
      "groups": [
        {
          "title": "Cruise",
          "fields": [
            "cruise_level",
            "cost_index",
            "cruise_wind",
            "isa_deviation"
          ]
        },
        {
          "title": "Levels",
          "fields": [
            "transition_altitude",
            "transition_level"
          ]
        }
      ]
    },
    {
      "id": "clearance",
      "title": "Clearance",
      "sub": "What ATC cleared you to fly. The same fields as the flight strip.",
      "selected": "sid",
      "ofp": {
        "from": "sid"
      },
      "groups": [
        {
          "title": "Departure clearance",
          "fields": [
            "runway",
            "sid",
            "transition",
            "initial_altitude",
            "squawk"
          ]
        },
        {
          "title": "Frequencies",
          "fields": [
            "ground_frequency",
            "tower_frequency",
            "departure_frequency"
          ]
        },
        {
          "title": "Notes from ATC",
          "notes": {
            "label": "Note",
            "description": "Anything else ATC told you."
          }
        }
      ]
    },
    {
      "id": "takeoff",
      "title": "Takeoff",
      "sub": "Numbers for the takeoff steps and the CDU's TAKEOFF REF page.",
      "selected": "v2",
      "ofp": {
        "from": "takeoff_weight",
        "title": "Takeoff speeds come from the FMC",
        "body": "The OFP plans the flight, not the takeoff. Speeds and trim come from the CDU's TAKEOFF REF page once weights and flaps are set. Some SimBrief layouts add takeoff performance at the end.",
        "note": "The FMC uses the takeoff weight for these speeds.",
        "not_in_plan": true
      },
      "groups": [
        {
          "title": "Runway",
          "fields": [
            "runway",
            "heading"
          ]
        },
        {
          "title": "Settings and speeds",
          "fields": [
            "takeoff_flaps",
            "thrust_rating",
            "assumed_temperature",
            "v1",
            "vr",
            "v2",
            "takeoff_trim"
          ]
        }
      ]
    },
    {
      "id": "approach",
      "title": "Approach",
      "sub": "Used by the Descent and Approach steps and the approach briefing. Arrival values live only here.",
      "selected": "arrival_runway",
      "ofp": {
        "from": "arrival_runway",
        "body": "Minimums come from the approach chart, and the landing speed and flaps from the CDU's APPROACH REF page. The OFP doesn't print them.",
        "note": "The arrival in the plan is where these values apply.",
        "not_in_plan": true,
        "outline": false
      },
      "groups": [
        {
          "title": "Arrival",
          "fields": [
            "arrival_runway",
            "star",
            "transition_level"
          ]
        },
        {
          "title": "Landing",
          "fields": [
            "minimums",
            "vref",
            "landing_flaps",
            "autobrake",
            "landing_altitude"
          ]
        }
      ]
    }
  ],
  "fields": [
    {
      "id": "origin",
      "label": "Departure",
      "description": "The airport you depart from. Its weather is on the Weather page.",
      "kind": "text",
      "location": "Enter on the CDU › RTE",
      "page": "route",
      "group": "Airports",
      "show_in": [
        "strip"
      ],
      "simbrief": [
        "origin"
      ],
      "input": {
        "max_length": 4
      }
    },
    {
      "id": "destination",
      "label": "Destination",
      "description": "Where you plan to land.",
      "kind": "text",
      "location": "Enter on the CDU › RTE",
      "page": "route",
      "group": "Airports",
      "show_in": [
        "strip"
      ],
      "strip": {
        "join": " → "
      },
      "simbrief": [
        "destination"
      ],
      "input": {
        "max_length": 4
      }
    },
    {
      "id": "alternate",
      "label": "Alternate",
      "description": "Where you'd divert if you couldn't land at the destination.",
      "kind": "text",
      "location": "Enter on the CDU › RTE 2",
      "page": "route",
      "group": "Airports",
      "simbrief": [
        "alternate"
      ],
      "input": {
        "max_length": 4
      }
    },
    {
      "id": "flight_number",
      "label": "Flight number",
      "description": "Your flight's number, as filed.",
      "kind": "text",
      "location": "Enter on the CDU › RTE",
      "page": "route",
      "group": "Airports",
      "simbrief": [
        "flight_number"
      ],
      "input": {
        "max_length": 7
      }
    },
    {
      "id": "route",
      "label": "Route",
      "description": "The filed route from the SID to the arrival, as you enter it in the CDU.",
      "kind": "text",
      "location": "Enter on the CDU › RTE",
      "page": "route",
      "group": "The route",
      "simbrief": [
        "route"
      ],
      "input": {
        "max_length": 400,
        "mode": "text"
      }
    },
    {
      "id": "runway",
      "label": "Runway",
      "description": "The runway you depart from.",
      "kind": "text",
      "location": "Enter on the CDU › DEP/ARR",
      "page": "clearance",
      "group": "Departure clearance",
      "show_in": [
        "strip"
      ],
      "strip": {
        "prefix": "RWY "
      },
      "simbrief": [
        "runway"
      ],
      "input": {
        "max_length": 4
      },
      "also": [
        {
          "page": "takeoff",
          "group": "Runway",
          "label": "Takeoff runway",
          "description": "Set in Clearance.",
          "ofp": {
            "from": "takeoff_weight",
            "title": "Takeoff speeds come from the FMC",
            "body": "The OFP plans the flight, not the takeoff. Speeds and trim come from the CDU's TAKEOFF REF page once weights and flaps are set. Some SimBrief layouts add takeoff performance at the end.",
            "note": "The FMC uses the takeoff weight for these speeds.",
            "not_in_plan": true
          }
        }
      ]
    },
    {
      "id": "sid",
      "label": "SID",
      "description": "The departure procedure.",
      "kind": "text",
      "location": "Enter on the CDU › DEP/ARR",
      "page": "clearance",
      "group": "Departure clearance",
      "show_in": [
        "strip"
      ],
      "simbrief": [
        "sid"
      ],
      "input": {
        "max_length": 8
      }
    },
    {
      "id": "transition",
      "label": "Transition",
      "description": "Where the SID joins your route.",
      "kind": "text",
      "location": "Enter on the CDU › DEP/ARR",
      "page": "clearance",
      "group": "Departure clearance",
      "show_in": [
        "strip"
      ],
      "strip": {
        "join": "."
      },
      "simbrief": [
        "transition"
      ],
      "input": {
        "max_length": 8
      }
    },
    {
      "id": "initial_altitude",
      "label": "Initial altitude",
      "description": "The altitude you're cleared to climb to first.",
      "kind": "number",
      "ranges": [
        {
          "min": 0.0,
          "max": 41000.0,
          "message": "Enter 0 to 41,000 ft"
        }
      ],
      "location": "Set on the MCP › ALTITUDE",
      "page": "clearance",
      "group": "Departure clearance",
      "show_in": [
        "strip"
      ],
      "strip": {
        "suffix": " FT"
      },
      "input": {
        "max_length": 5,
        "mode": "numeric"
      }
    },
    {
      "id": "squawk",
      "label": "Squawk",
      "description": "Your transponder code.",
      "kind": "text",
      "location": "Set on the transponder",
      "page": "clearance",
      "group": "Departure clearance",
      "show_in": [
        "strip"
      ],
      "strip": {
        "prefix": "SQK "
      },
      "input": {
        "max_length": 4,
        "mode": "numeric"
      },
      "ofp": {
        "title": "Your squawk comes from ATC"
      }
    },
    {
      "id": "ground_frequency",
      "label": "Ground",
      "description": "For pushback and taxi.",
      "kind": "text",
      "location": "Set on the radio panel",
      "page": "clearance",
      "group": "Frequencies",
      "show_in": [
        "strip"
      ],
      "strip": {
        "prefix": "GND "
      },
      "input": {
        "max_length": 7,
        "mode": "decimal"
      },
      "ofp": {
        "title": "Frequencies come from the chart and ATIS"
      }
    },
    {
      "id": "tower_frequency",
      "label": "Tower",
      "description": "For takeoff.",
      "kind": "text",
      "location": "Set on the radio panel",
      "page": "clearance",
      "group": "Frequencies",
      "input": {
        "max_length": 7,
        "mode": "decimal"
      },
      "ofp": {
        "title": "Frequencies come from the chart and ATIS"
      }
    },
    {
      "id": "departure_frequency",
      "label": "Departure frequency",
      "description": "The frequency to call after takeoff.",
      "kind": "text",
      "location": "Set on the radio panel",
      "page": "clearance",
      "group": "Frequencies",
      "show_in": [
        "strip"
      ],
      "strip": {
        "prefix": "DEP "
      },
      "input": {
        "max_length": 7,
        "mode": "decimal",
        "placeholder": "Enter"
      },
      "ofp": {
        "title": "Frequencies come from the chart and ATIS"
      }
    },
    {
      "id": "qnh",
      "label": "Altimeter setting (departure)",
      "kind": "number",
      "unit": "qnh_unit",
      "ranges": [
        {
          "unit": "inHg",
          "min": 28.0,
          "max": 31.0,
          "message": "Enter 28.00 to 31.00 inHg"
        },
        {
          "unit": "hPa",
          "min": 948.0,
          "max": 1050.0,
          "message": "Enter 948 to 1050 hPa"
        }
      ],
      "simbrief": [
        "origin_altimeter"
      ],
      "spoken": "QNH"
    },
    {
      "id": "destination_qnh",
      "label": "Altimeter setting (destination)",
      "kind": "number",
      "unit": "qnh_unit",
      "ranges": [
        {
          "unit": "inHg",
          "min": 28.0,
          "max": 31.0,
          "message": "Enter 28.00 to 31.00 inHg"
        },
        {
          "unit": "hPa",
          "min": 948.0,
          "max": 1050.0,
          "message": "Enter 948 to 1050 hPa"
        }
      ],
      "simbrief": [
        "destination_altimeter"
      ],
      "spoken": "QNH"
    },
    {
      "id": "heading",
      "label": "Runway heading",
      "description": "The heading of your takeoff runway.",
      "kind": "number",
      "ranges": [
        {
          "min": 1.0,
          "max": 360.0,
          "message": "Enter 001 to 360"
        }
      ],
      "location": "Set on the MCP › HEADING",
      "page": "takeoff",
      "group": "Runway",
      "input": {
        "max_length": 3,
        "mode": "numeric"
      },
      "show": {
        "suffix": "°"
      },
      "spoken": "runway heading"
    },
    {
      "id": "takeoff_flaps",
      "label": "Flaps",
      "description": "Takeoff flaps for your weight and runway.",
