        {
          "value": "15"
        },
        {
          "value": "25"
        }
      ],
      "location": "Enter on the CDU › TAKEOFF REF",
      "page": "takeoff",
      "group": "Settings and speeds"
    },
    {
      "id": "landing_flaps",
