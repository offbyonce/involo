{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhasesFile",
  "description": "`phases.yaml`.",
  "type": "object",
  "properties": {
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UserOption"
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Phase"
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Stage"
      }
    },
    "turnaround": {
      "description": "Which option choices make a turnaround, for steps in Essentials only on a turnaround\n(`quick: turnaround`). Required when any step uses it.",
      "anyOf": [
        {
          "$ref": "#/$defs/ShowIf"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "stages",
    "phases"
  ],
  "$defs": {
    "FillField": {
      "description": "The fixed list of flight values the app can fill in. Packs cannot add names; a new one\nneeds an app release.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "origin",
            "destination",
            "flight_number",
            "route",
            "runway",
            "sid",
            "transition",
            "initial_altitude",
            "squawk",
            "ground_frequency",
            "tower_frequency",
            "departure_frequency",
            "heading",
            "takeoff_flaps",
            "landing_flaps",
            "v1",
            "vr",
            "v2",
            "vref",
            "cg",
            "takeoff_trim",
            "autobrake",
            "minimums",
            "landing_altitude",
            "minimum_takeoff_fuel",
            "fuel",
            "zfw",
            "takeoff_weight",
            "passengers",
            "cargo",
            "reserves",
            "cost_index",
            "cruise_level",
            "cruise_wind",
            "assumed_temperature",
            "thrust_reduction_altitude",
            "acceleration_altitude",
            "isa_deviation",
            "transition_altitude",
            "transition_level",
            "utc_time",
            "utc_date"
          ]
        },
        {
          "description": "A blank the pilot types in, with no linked value. Only valid in a step's `fill`.",
          "type": "string",
          "const": "manual"
        },
        {
          "description": "The first alternate airport (decision 0019, amended).",
          "type": "string",
          "const": "alternate"
        },
        {
          "description": "The departure airport's altimeter setting.",
          "type": "string",
          "const": "qnh"
        },
        {
          "description": "The destination airport's altimeter setting.",
          "type": "string",
          "const": "destination_qnh"
        },
        {
          "description": "The runway the pilot expects to land on.",
          "type": "string",
          "const": "arrival_runway"
        },
        {
          "description": "The arrival procedure.",
          "type": "string",
          "const": "star"
        },
        {
          "description": "The takeoff thrust rating, e.g. `26K`.",
          "type": "string",
          "const": "thrust_rating"
        },
        {
          "description": "`LB` or `KG`, for fuel and weights.",
          "type": "string",
          "const": "weight_unit"
        },
        {
          "description": "`inHg` or `hPa`, for the QNH.",
          "type": "string",
          "const": "qnh_unit"
        },
        {
          "description": "`BARO` or `RADIO`, for the minimums.",
          "type": "string",
          "const": "minimums_type"
        },
        {
          "description": "Fuel in thousands, rounded up to the next tenth (calculated).",
          "type": "string",
          "const": "fuel_thousands"
        },
        {
          "description": "Fuel plus zero fuel weight, in thousands (calculated).",
          "type": "string",
          "const": "gross_weight"
        },
        {
          "description": "Outside air temperature at top of climb (calculated).",
          "type": "string",
          "const": "top_of_climb_oat"
        },
        {
          "description": "Latitude and longitude of the departure airport.",
          "type": "string",
          "const": "origin_position"
        },
        {
          "description": "The navigation database cycle (calculated).",
          "type": "string",
          "const": "nav_database"
        },
        {
          "description": "The dates that cycle is active (calculated).",
          "type": "string",
          "const": "nav_active_dates"
        },
        {
          "description": "One row of the route. Only valid in CDU text, with an `index` and a `part`.",
          "type": "string",
          "const": "route_leg"
        }
      ]
    },
    "IntroParagraph": {
      "description": "One paragraph of a phase's introduction.",
      "type": "object",
      "properties": {
        "heading": {
          "description": "A short lead-in shown before the text, e.g. \"When to use them\".",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "text"
      ]
    },
    "OptionChoice": {
      "description": "How one value of an option is shown, e.g. \"Ground power at the gate\".",
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ]
    },
    "OptionTest": {
      "description": "One test against a pilot-chosen option. The options are declared by the pack.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "equals": {
              "type": "string"
            },
            "option": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "option",
            "equals"
          ]
        },
        {
          "type": "object",
          "properties": {
            "one_of": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "option": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "option",
            "one_of"
          ]
        }
      ]
    },
    "Phase": {
      "description": "One part of the flight, holding its lists in order.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "intro": {
          "description": "Shown at the top of the phase.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/IntroParagraph"
          }
        },
        "lists": {
          "description": "Ids of the lists in this phase.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference": {
          "description": "Reference material, outside the normal flow of a flight.",
          "type": "boolean"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "lists"
      ]
    },
    "ShowIf": {
      "description": "When something is shown. Deliberately small: tests combine one level deep, with no\nnegation, comparisons, step state or expressions.",
      "anyOf": [
        {
          "$ref": "#/$defs/OptionTest"
        },
        {
          "type": "object",
          "properties": {
            "all_of": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/OptionTest"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "all_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "any_of": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/OptionTest"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "any_of"
          ]
        }
      ]
    },
    "Stage": {
      "description": "A group of phases, e.g. \"Preflight\".",
      "type": "object",
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StagePhase"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "phases"
      ]
    },
    "StagePhase": {
      "description": "A phase's place in a stage.",
      "type": "object",
      "properties": {
        "phase": {
          "type": "string"
        },
        "show_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShowIf"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "phase"
      ]
    },
    "SuggestLine": {
      "description": "A suggestion rule's line and margin in the other unit.",
      "type": "object",
      "properties": {
        "more_than": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "near": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "more_than"
      ]
    },
    "SuggestRule": {
      "description": "A weight from the flight, less `minus`, above `more_than` suggests `then`, otherwise\n`otherwise`; within `near` of `more_than` the suggestion says it is close to the line\n(decision 0027). The amounts are in `unit`. With `minus` at 0, nothing is suggested.",
      "type": "object",
      "properties": {
        "field": {
          "$ref": "#/$defs/FillField"
        },
        "minus": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "more_than": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "near": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "other_unit": {
          "description": "The line and margin for a flight in the other unit, when the choices name both\n(\"More than 1,000 lb (450 kg)\"): a pound flight is held to 1,000 lb, not 992.",
          "anyOf": [
            {
              "$ref": "#/$defs/SuggestLine"
            },
            {
              "type": "null"
            }
          ]
        },
        "otherwise": {
          "type": "string"
        },
        "then": {
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/WeightUnit"
        }
      },
      "additionalProperties": false,
      "required": [
        "field",
        "unit",
        "minus",
        "more_than",
        "then",
        "otherwise"
      ]
    },
    "Suggests": {
      "description": "What suggests an option's answer: a rule (decision 0027), or, as format 4 wrote it, a bare\nflight field, which suggests nothing.",
      "anyOf": [
        {
          "$ref": "#/$defs/SuggestRule"
        },
        {
          "$ref": "#/$defs/FillField"
        }
      ]
    },
    "UserOption": {
      "description": "A choice the pilot makes that decides what is shown, e.g. the power source.",
      "type": "object",
      "properties": {
        "ask_in": {
          "description": "Phases that show the choice above their lists.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "choices": {
          "description": "How each value is shown. When present, every value has exactly one.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptionChoice"
          }
        },
        "default": {
          "description": "The value used until the pilot chooses. Must be one of `values`.",
          "type": "string"
        },
        "description": {
          "description": "What the choice changes, shown beside it.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "suggests": {
          "description": "How a flight value suggests the answer, for the pilot to confirm (decisions 0022 and\n0027).",
          "anyOf": [
            {
              "$ref": "#/$defs/Suggests"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "values",
        "default"
      ]
    },
    "WeightUnit": {
      "description": "A unit for a suggestion rule's amounts.",
      "type": "string",
      "enum": [
        "kg",
        "lb"
      ]
    }
  }
}
