{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhasesFile",
  "description": "`phases.yaml`.",
  "type": "object",
  "properties": {
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UserOption"
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Phase"
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Stage"
      }
    },
    "turnaround": {
      "description": "Which option choices make a turnaround, for steps in Essentials only on a turnaround\n(`quick: turnaround`). Required when any step uses it.",
      "anyOf": [
        {
          "$ref": "#/$defs/ShowIf"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "stages",
    "phases"
  ],
  "$defs": {
    "FieldId": {
      "description": "A flight field's id, e.g. `zfw`: one of the fields the pack defines in `flight.yaml`\n(decision 0029), or one of the app's own, [`FieldId::MANUAL`] and [`FieldId::ROUTE_LEG`].\nSaved flights key their values by it, as text.",
      "type": "string"
    },
    "IntroParagraph": {
      "description": "One paragraph of a phase's introduction.",
      "type": "object",
      "properties": {
        "heading": {
          "description": "A short lead-in shown before the text, e.g. \"When to use them\".",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "text"
      ]
    },
    "OptionChoice": {
      "description": "How one value of an option is shown, e.g. \"Ground power at the gate\".",
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ]
    },
    "OptionTest": {
      "description": "One test against a pilot-chosen option. The options are declared by the pack.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "equals": {
              "type": "string"
            },
            "option": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "option",
            "equals"
          ]
        },
        {
          "type": "object",
          "properties": {
            "one_of": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "option": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "option",
            "one_of"
          ]
        }
      ]
    },
    "Phase": {
      "description": "One part of the flight, holding its lists in order.",
      "type": "object",
      "properties": {
        "engine_start": {
          "description": "The phase that starts the engines, on at most one flight phase: Practice's \"Before\nengine start\" covers the flight up to and including it.",
          "type": "boolean"
        },
        "group": {
          "description": "Which reference group the phase is, required on a reference phase: `memory` (memory\nitems), `quick` (quick reference) or `procedures` (non-normal procedures). The app\nreads reference phases by group, never by their order or title (decision 0029).",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "intro": {
          "description": "Shown at the top of the phase.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/IntroParagraph"
          }
        },
        "lists": {
          "description": "Ids of the lists in this phase.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference": {
          "description": "Reference material, outside the normal flow of a flight.",
          "type": "boolean"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "lists"
      ]
    },
    "ShowIf": {
      "description": "When something is shown. Deliberately small: tests combine one level deep, with no\nnegation, comparisons, step state or expressions.",
      "anyOf": [
        {
          "$ref": "#/$defs/OptionTest"
        },
        {
          "type": "object",
          "properties": {
            "all_of": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/OptionTest"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "all_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "any_of": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/OptionTest"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "any_of"
          ]
        }
      ]
    },
    "Stage": {
      "description": "A group of phases, e.g. \"Preflight\".",
      "type": "object",
      "properties": {
        "id": {
          "description": "Unique in the pack, and never changes once published: the rail, Find and a pack\nextending this one name the stage by it (decision 0029). The title is display text.",
          "type": "string"
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StagePhase"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "phases"
      ]
    },
    "StagePhase": {
      "description": "A phase's place in a stage.",
      "type": "object",
      "properties": {
        "phase": {
          "type": "string"
        },
        "show_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShowIf"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "phase"
      ]
    },
    "StartControl": {
      "description": "An option on the Start page (decision 0029): its control style, and optionally its own\ntitle and description there (the option's own are used otherwise) and a link to a phase.",
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "link": {
          "anyOf": [
            {
              "$ref": "#/$defs/StartLink"
            },
            {
              "type": "null"
            }
          ]
        },
        "style": {
          "$ref": "#/$defs/StartStyle"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "style"
      ]
    },
    "StartLink": {
      "description": "A link from a Start page option to a phase, e.g. \"Preview the inspection\".",
      "type": "object",
      "properties": {
        "phase": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "phase",
        "text"
      ]
    },
    "StartStyle": {
      "description": "How the Start page draws an option: one card per choice, or a segmented row.",
      "type": "string",
      "enum": [
        "cards",
        "row"
      ]
    },
    "SuggestLine": {
      "description": "A suggestion rule's line and margin in the other unit.",
      "type": "object",
      "properties": {
        "more_than": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "near": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "more_than"
      ]
    },
    "SuggestRule": {
      "description": "A weight from the flight, less `minus`, above `more_than` suggests `then`, otherwise\n`otherwise`; within `near` of `more_than` the suggestion says it is close to the line\n(decision 0027). The amounts are in `unit`. With `minus` at 0, nothing is suggested.",
      "type": "object",
      "properties": {
        "field": {
          "$ref": "#/$defs/FieldId"
        },
        "minus": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "more_than": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "near": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "other_unit": {
          "description": "The line and margin for a flight in the other unit, when the choices name both\n(\"More than 1,000 lb (450 kg)\"): a pound flight is held to 1,000 lb, not 992.",
          "anyOf": [
            {
              "$ref": "#/$defs/SuggestLine"
            },
            {
              "type": "null"
            }
          ]
        },
        "otherwise": {
          "type": "string"
        },
        "then": {
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/WeightUnit"
        }
      },
      "additionalProperties": false,
      "required": [
        "field",
        "unit",
        "minus",
        "more_than",
        "then",
        "otherwise"
      ]
    },
    "Suggests": {
      "description": "What suggests an option's answer: a rule (decision 0027), or, as format 4 wrote it, a bare\nflight field, which suggests nothing.",
      "anyOf": [
        {
          "$ref": "#/$defs/SuggestRule"
        },
        {
          "$ref": "#/$defs/FieldId"
        }
      ]
    },
    "UserOption": {
      "description": "A choice the pilot makes that decides what is shown, e.g. the power source.",
      "type": "object",
      "properties": {
        "ask_in": {
          "description": "Phases that show the choice above their lists, and `start` for the Start page.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "choices": {
          "description": "How each value is shown. When present, every value has exactly one.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptionChoice"
          }
        },
        "default": {
          "description": "The value used until the pilot chooses. Must be one of `values`.",
          "type": "string"
        },
        "description": {
          "description": "What the choice changes, shown beside it.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "start": {
          "description": "How the Start page shows the choice; required when `ask_in` names `start`.",
          "anyOf": [
            {
              "$ref": "#/$defs/StartControl"
            },
            {
              "type": "null"
            }
          ]
        },
        "suggests": {
          "description": "How a flight value suggests the answer, for the pilot to confirm (decisions 0022 and\n0027).",
          "anyOf": [
            {
              "$ref": "#/$defs/Suggests"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "values",
        "default"
      ]
    },
    "WeightUnit": {
      "description": "A unit for a suggestion rule's amounts.",
      "type": "string",
      "enum": [
        "kg",
        "lb"
      ]
    }
  }
}
